---
import '@fontsource-variable/nunito';
import '@fontsource-variable/fraunces';
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { getLocaleFromPath, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const currentPath = Astro.url.pathname;
const locale = getLocaleFromPath(currentPath);
const t = useTranslations(locale);

// Base-Praefix fuer absolute Pfade (GitHub Pages Unterordner), ohne End-Slash.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const { title, description = t('site.tagline') } = Astro.props;
const pageTitle = title ? `${title} · ${t('site.name')}` : `${t('site.name')} · ${t('site.tagline')}`;
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#c87a5e" />

    <script is:inline>
      (function () {
        function getStoredTheme() {
          try {
            var m = document.cookie.match(/(?:^|;\s*)theme=(dark|light)(?:;|$)/);
            return (m && m[1]) || localStorage.getItem('theme');
          } catch (e) {
            return null;
          }
        }
        function applyTheme() {
          document.documentElement.classList.remove('no-js');
          var stored = getStoredTheme();
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyTheme();
      })();
    </script>

    <script is:inline define:vars={{ base }}>
      (function () {
        var path = window.location.pathname;
        // Nur auf der deutschen Startseite (inkl. Base-Praefix) weiterleiten.
        var home = base + '/';
        if (path !== home && path !== base + '/index.html') return;

        function getPreferred() {
          try {
            var m = document.cookie.match(/(?:^|;\s*)preferred-lang=(de|en)(?:;|$)/);
            return (m && m[1]) || localStorage.getItem('preferred-lang');
          } catch (e) {
            return null;
          }
        }

        var pref = getPreferred();
        if (!pref) {
          var nav = (navigator.language || 'de').toLowerCase();
          pref = nav.indexOf('de') === 0 ? 'de' : 'en';
        }
        if (pref === 'en') {
          window.location.replace(base + '/en/');
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{locale === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
