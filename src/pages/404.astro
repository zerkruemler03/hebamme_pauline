---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { localePath, useTranslations } from '../i18n/utils';

const t = useTranslations('de');
---

<BaseLayout title={t('notfound.title')}>
  <Section>
    <div class="mx-auto max-w-xl text-center">
      <p class="text-7xl font-bold text-[var(--color-accent)]">404</p>
      <h1 class="mt-4 text-3xl">{t('notfound.title')}</h1>
      <p class="mt-3 text-[var(--color-text-secondary)]">{t('notfound.text')}</p>
      <a
        href={localePath('/', 'de')}
        class="mt-8 inline-flex items-center justify-center rounded-full bg-[var(--color-accent)] px-7 py-3.5 font-bold text-[var(--color-text-inverse)] no-underline transition-colors hover:bg-[var(--color-accent-hover)]"
      >
        {t('notfound.cta')}
      </a>
    </div>
  </Section>
</BaseLayout>
