---
import { cn } from '../utils/cn';
import Icon, { type IconName } from './Icon.astro';

type Platform = 'instagram' | 'whatsapp' | 'maps';

interface Props {
  platform: Platform;
  href: string;
  label: string;
  class?: string;
  variant?: 'icon' | 'button';
}

const { platform, href, label, class: className, variant = 'icon' } = Astro.props;

const config: Record<Platform, { brand: string; icon: IconName }> = {
  instagram: { brand: '#E1306C', icon: 'instagram' },
  whatsapp: { brand: '#25D366', icon: 'whatsapp' },
  maps: { brand: '#1A73E8', icon: 'googlemaps' },
};

const { brand, icon } = config[platform];
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  title={label}
  data-platform={platform}
  class={cn(
    'social-link',
    variant === 'icon' ? 'social-link--icon' : 'social-link--button',
    className
  )}
  style={`--brand:${brand}`}
>
  <Icon name={icon} class="social-glyph" />
  {
    variant === 'button' && (
      <>
        <span class="social-text">{label}</span>
        <Icon name="arrow-up-right" class="external-arrow" />
      </>
    )
  }
</a>
