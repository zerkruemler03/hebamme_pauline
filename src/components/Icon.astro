---
import arrowUpRight from '../assets/icons/arrow-up-right.svg?raw';
import googlemaps from '../assets/icons/googlemaps.svg?raw';
import instagram from '../assets/icons/instagram.svg?raw';
import whatsapp from '../assets/icons/whatsapp.svg?raw';

const icons = {
  'arrow-up-right': arrowUpRight,
  instagram,
  whatsapp,
  googlemaps,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<span class={className} set:html={icons[name]}></span>
