---
/**
 * Zentrale Icon-Komponente – eine einzige Quelle der Wahrheit fuer wiederverwendete SVGs.
 * Neues Icon? Einfach einen Eintrag in `paths` ergaenzen und ueber `name` nutzen.
 */
export type IconName = 'arrow-up-right';

interface Props {
  name: IconName;
  /** Kantenlaenge in px (quadratisch). */
  size?: number;
  class?: string;
  /** Strichstaerke des Icons. */
  strokeWidth?: number;
}

const { name, size = 14, class: className, strokeWidth = 2.5 } = Astro.props;

// SVG-Pfaddaten pro Icon. Alle Icons teilen dieselbe 24x24-ViewBox.
const paths: Record<IconName, string[]> = {
  // Pfeil nach schraeg rechts oben – kennzeichnet externe Links.
  'arrow-up-right': ['M7 17 17 7', 'M8 7h9v9'],
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
