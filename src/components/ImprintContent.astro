---
import { site } from '../data/site';
import { useTranslations, type Locale } from '../i18n/utils';
import Section from './Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const c = site.contact;
const a = site.supervisoryAuthority;
const isDe = locale === 'de';
---

<Section>
  <article class="prose-page mx-auto max-w-2xl">
    <h1 class="text-4xl">{t('imprint.title')}</h1>

    <h2>{t('imprint.tmg')}</h2>
    <p>
      {c.name}<br />
      {c.street}<br />
      {c.zip}&nbsp;{c.city}<br />
      {c.country}
    </p>

    <h2>{t('imprint.contact')}</h2>
    <p>
      {isDe ? 'Telefon' : 'Phone'}: <a href={`tel:${c.phoneLink}`}>{c.phone}</a><br />
      {isDe ? 'E-Mail' : 'E-mail'}: <a href={`mailto:${c.email}`}>{c.email}</a>
    </p>

    <h2>{t('imprint.profession.title')}</h2>
    <p>
      <strong>{t('imprint.jobTitle')}:</strong><br />
      {t('imprint.jobTitleValue')}
    </p>

    <h3>{t('imprint.authority.title')}</h3>
    <p>
      {a.name}<br />
      {a.street}<br />
      {a.zip}&nbsp;{a.city}<br />
      {isDe ? 'Telefon' : 'Phone'}: <a href={`tel:${a.phone.replace(/[\s-]/g, '')}`}>{a.phone}</a><br />
      {isDe ? 'E-Mail' : 'E-mail'}: <a href={`mailto:${a.email}`}>{a.email}</a>
    </p>

    <h3>{t('imprint.rules.title')}</h3>
    <ul>
      <li>{t('imprint.rules.li1')}</li>
      <li>{t('imprint.rules.li2')}</li>
      <li>{t('imprint.rules.li3')}</li>
    </ul>
    <p>{t('imprint.rules.note')}</p>

    <h2>{t('imprint.responsible')}</h2>
    <p>
      {c.name}<br />
      {c.street}<br />
      {c.zip}&nbsp;{c.city}
    </p>

    <h2>{t('imprint.disclaimer.title')}</h2>
    <p>{t('imprint.disclaimer.text')}</p>
  </article>
</Section>
