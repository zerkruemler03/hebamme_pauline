---
import { site } from '../data/site';
import { getLocaleFromPath, localePath, useTranslations } from '../i18n/utils';
import Icon from './Icon.astro';
import SocialIcon from './SocialIcon.astro';

const currentPath = Astro.url.pathname;
const locale = getLocaleFromPath(currentPath);
const t = useTranslations(locale);

const year = new Date().getFullYear();
const c = site.contact;
---

<footer class="mt-[var(--space-3xl)] border-t border-[var(--color-border)] bg-[var(--color-bg-secondary)]">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3">
    <div>
      <h2 class="mb-3 text-base font-bold uppercase tracking-wide text-[var(--color-text-secondary)]">
        {t('footer.contact')}
      </h2>
      <p class="font-semibold text-[var(--color-text)]">{c.name}</p>
      <p class="text-[var(--color-text-secondary)]">{c.role}</p>
      <address class="mt-3 not-italic text-[var(--color-text-secondary)]">
        {c.street}<br />
        {c.zip}&nbsp;{c.city}<br />
        {c.country}
      </address>
      <a
        href={site.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-accent)]"
      >
        {t('footer.mapsReview')}
        <Icon name="arrow-up-right" class="footer-arrow" />
      </a>
    </div>

    <div>
      <h2 class="mb-3 text-base font-bold uppercase tracking-wide text-[var(--color-text-secondary)]">
        {t('footer.social')}
      </h2>
      <div class="flex gap-3">
        <SocialIcon platform="instagram" href={site.instagramUrl} label={t('contact.instagram')} />
        <SocialIcon platform="whatsapp" href={site.whatsappUrl} label={t('contact.whatsapp')} />
        <SocialIcon platform="maps" href={site.mapsUrl} label={t('contact.maps')} />
      </div>
      <p class="mt-4 max-w-xs text-xs leading-relaxed text-[var(--color-text-secondary)]">
        {t('contact.consentHint')}
      </p>
    </div>

    <div>
      <h2 class="mb-3 text-base font-bold uppercase tracking-wide text-[var(--color-text-secondary)]">
        {t('footer.legal')}
      </h2>
      <ul class="flex flex-col gap-2" role="list">
        <li>
          <a href={localePath('/impressum', locale)} class="text-[var(--color-text-secondary)] no-underline hover:text-[var(--color-accent)]">
            {t('footer.imprint')}
          </a>
        </li>
        <li>
          <a href={localePath('/datenschutz', locale)} class="text-[var(--color-text-secondary)] no-underline hover:text-[var(--color-accent)]">
            {t('footer.privacy')}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--color-border)]">
    <p class="mx-auto max-w-6xl px-4 py-5 text-center text-sm text-[var(--color-text-secondary)] sm:px-6">
      © {year} {t('site.name')}. {t('footer.rights')}
    </p>
  </div>
</footer>
