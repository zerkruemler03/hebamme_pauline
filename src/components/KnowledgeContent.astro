---
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const sections = [
  {
    id: 'bis-25-km',
    label: t('knowledge.wegegeld.b1.label'),
    title: t('knowledge.wegegeld.b1.title'),
  },
  {
    id: 'weiter-entfernt',
    label: t('knowledge.wegegeld.b2.label'),
    title: t('knowledge.wegegeld.b2.title'),
  },
  {
    id: 'privat-versichert',
    label: t('knowledge.wegegeld.b3.label'),
    title: t('knowledge.wegegeld.b3.title'),
  },
  {
    id: 'betreuungsgebiet',
    label: t('knowledge.wegegeld.b4.label'),
    title: t('knowledge.wegegeld.b4.title'),
  },
];
---

<article class="knowledge">
  <header class="kn-header">
    <div class="kn-container">
      <p class="kn-eyebrow">{t('knowledge.eyebrow')}</p>
      <h1 class="kn-title">{t('knowledge.title')}</h1>
      <p class="kn-subtitle">{t('knowledge.subtitle')}</p>
    </div>
  </header>

  <div class="kn-container kn-body">
    <div class="kn-lead-row">
      <h2 class="kn-article-title">{t('knowledge.wegegeld.title')}</h2>
      <p class="kn-lead">{t('knowledge.wegegeld.lead')}</p>
    </div>

    <nav class="kn-toc" aria-label={t('knowledge.wegegeld.toc')}>
      <p class="kn-toc-title">{t('knowledge.wegegeld.toc')}</p>
      <ol class="kn-toc-list">
        {
          sections.map((s, i) => (
            <li>
              <a href={`#${s.id}`}>
                <span class="kn-toc-num">{i + 1}</span>
                {s.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <section id="bis-25-km" class="kn-section">
      <div class="kn-marker" aria-hidden="true">1</div>
      <div class="kn-section-body">
        <p class="kn-label">{t('knowledge.wegegeld.b1.label')}</p>
        <h3 class="kn-h3">{t('knowledge.wegegeld.b1.title')}</h3>
        <p>{t('knowledge.wegegeld.b1.text')}</p>
      </div>
    </section>

    <section id="weiter-entfernt" class="kn-section">
      <div class="kn-marker" aria-hidden="true">2</div>
      <div class="kn-section-body">
        <p class="kn-label">{t('knowledge.wegegeld.b2.label')}</p>
        <h3 class="kn-h3">{t('knowledge.wegegeld.b2.title')}</h3>
        <p>{t('knowledge.wegegeld.b2.text')}</p>
        <ul class="kn-list">
          <li>{t('knowledge.wegegeld.b2.li1')}</li>
          <li>{t('knowledge.wegegeld.b2.li2')}</li>
        </ul>
        <p class="kn-note">{t('knowledge.wegegeld.b2.note')}</p>
      </div>
    </section>

    <section id="privat-versichert" class="kn-section">
      <div class="kn-marker" aria-hidden="true">3</div>
      <div class="kn-section-body">
        <p class="kn-label">{t('knowledge.wegegeld.b3.label')}</p>
        <h3 class="kn-h3">{t('knowledge.wegegeld.b3.title')}</h3>
        <p>{t('knowledge.wegegeld.b3.text')}</p>
      </div>
    </section>

    <section id="betreuungsgebiet" class="kn-section">
      <div class="kn-marker" aria-hidden="true">4</div>
      <div class="kn-section-body">
        <p class="kn-label">{t('knowledge.wegegeld.b4.label')}</p>
        <h3 class="kn-h3">{t('knowledge.wegegeld.b4.title')}</h3>
        <p>{t('knowledge.wegegeld.b4.text')}</p>
      </div>
    </section>

    <footer class="kn-source">
      <p>{t('knowledge.wegegeld.source')}</p>
    </footer>
  </div>
</article>
