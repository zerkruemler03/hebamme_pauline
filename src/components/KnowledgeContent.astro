---
import { Image } from 'astro:assets';
import karte from '../assets/karte.png';
import { site } from '../data/site';
import { useTranslations, type Locale } from '../i18n/utils';
import Section from './Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section>
  <div class="mx-auto max-w-3xl text-center">
    <h1 class="text-4xl sm:text-5xl">{t('knowledge.title')}</h1>
    <p class="mt-3 text-lg text-[var(--color-text-secondary)]">{t('knowledge.subtitle')}</p>
  </div>

  <article class="mx-auto mt-12 max-w-3xl">
    <div class="rounded-[var(--radius-2xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-[var(--shadow-md)] sm:p-10">
      <h2 class="text-2xl sm:text-3xl">{t('knowledge.wegegeld.title')}</h2>
      <p class="mt-4 text-[var(--color-text-secondary)]">{t('knowledge.wegegeld.intro')}</p>

      <div class="mt-8 space-y-6">
        <div class="info-block">
          <h3 class="text-xl">{t('knowledge.wegegeld.b1.title')}</h3>
          <p class="mt-2 text-[var(--color-text-secondary)]">{t('knowledge.wegegeld.b1.text')}</p>
        </div>

        <div class="info-block">
          <h3 class="text-xl">{t('knowledge.wegegeld.b2.title')}</h3>
          <p class="mt-2 text-[var(--color-text-secondary)]">{t('knowledge.wegegeld.b2.text')}</p>
          <ul class="mt-3 list-disc space-y-1 pl-6 text-[var(--color-text-secondary)]">
            <li>{t('knowledge.wegegeld.b2.li1')}</li>
            <li>{t('knowledge.wegegeld.b2.li2')}</li>
          </ul>
          <p class="mt-3 text-[var(--color-text-secondary)]">{t('knowledge.wegegeld.b2.note')}</p>
        </div>

        <div class="info-block">
          <h3 class="text-xl">{t('knowledge.wegegeld.b3.title')}</h3>
          <p class="mt-2 text-[var(--color-text-secondary)]">{t('knowledge.wegegeld.b3.text')}</p>
        </div>

        <div class="info-block">
          <h3 class="text-xl">{t('knowledge.wegegeld.b4.title')}</h3>
          <p class="mt-2 text-[var(--color-text-secondary)]">{t('knowledge.wegegeld.b4.text')}</p>
        </div>
      </div>

      <p class="mt-8 border-t border-[var(--color-border)] pt-4 text-sm italic text-[var(--color-text-secondary)]">
        {t('knowledge.wegegeld.source')}
      </p>
    </div>
  </article>

  <!-- Karte Betreuungsgebiet -->
  <div class="mx-auto mt-12 max-w-3xl">
    <h2 class="text-center text-2xl sm:text-3xl">{t('area.title')}</h2>
    <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-6 block">
      <Image
        src={karte}
        alt={t('area.mapAlt')}
        width={880}
        height={919}
        class="w-full rounded-[var(--radius-2xl)] shadow-[var(--shadow-lg)] transition-transform hover:scale-[1.01]"
        loading="lazy"
      />
    </a>
    <p class="mt-3 text-center text-sm text-[var(--color-text-secondary)]">{t('contact.consentHint')}</p>
  </div>
</Section>

<style>
  .info-block {
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent);
  }
</style>
