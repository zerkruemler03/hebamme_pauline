---
import { Image } from 'astro:assets';
import karte from '../assets/img/karte.png';
import logo from '../assets/img/logo-main.png';
import { site } from '../data/site';
import { useTranslations, type Locale } from '../i18n/utils';
import { loadSlides } from '../utils/slides';
import ImageSlider from './ImageSlider.svelte';
import Icon from './Icon.astro';
import Section from './Section.astro';
import SocialIcon from './SocialIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const slides = await loadSlides((i) => t(`slider.alt${i + 1}` as 'slider.alt1'));

const services = [
  { title: t('services.pregnancy.title'), text: t('services.pregnancy.text') },
  { title: t('services.birth.title'), text: t('services.birth.text') },
  { title: t('services.postnatal.title'), text: t('services.postnatal.text') },
  { title: t('services.counseling.title'), text: t('services.counseling.text') },
];
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[var(--color-accent-soft)] to-transparent opacity-70"></div>
  <div class="relative mx-auto flex max-w-6xl flex-col items-center gap-8 px-4 py-[var(--space-3xl)] text-center sm:px-6">
    <Image src={logo} alt={t('site.name')} width={360} height={485} class="logo-plate h-40 w-40 sm:h-48 sm:w-48" loading="eager" />
    <div class="flex flex-col items-center gap-4">
      <h1 class="max-w-3xl text-4xl sm:text-5xl md:text-6xl">{t('hero.title')}</h1>
      <p class="max-w-2xl text-lg text-[var(--color-text-secondary)] sm:text-xl">{t('hero.subtitle')}</p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="#kontakt" class="btn-primary">{t('hero.cta.contact')}</a>
    </div>
    <div class="flex items-center gap-3 pt-2">
      <SocialIcon platform="instagram" href={site.instagramUrl} label={t('contact.instagram')} />
      <SocialIcon platform="whatsapp" href={site.whatsappUrl} label={t('contact.whatsapp')} />
    </div>
  </div>
</section>

<Section class="!pt-0">
  <ImageSlider
    client:visible
    slides={slides}
    labelPrev={t('slider.prev')}
    labelNext={t('slider.next')}
    interval={5000}
  />
</Section>

<Section id="leistungen" tone="secondary">
  <div class="mb-12 text-center">
    <h2 class="text-3xl sm:text-4xl">{t('services.title')}</h2>
    <p class="mt-3 text-[var(--color-text-secondary)]">{t('services.subtitle')}</p>
  </div>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      services.map((s) => (
        <article class="card min-w-0">
          <h3 class="text-xl">{s.title}</h3>
          <p class="mt-2 text-[var(--color-text-secondary)]">{s.text}</p>
        </article>
      ))
    }
  </div>
</Section>

<Section id="gebiet">
  <div class="grid items-center gap-10 md:grid-cols-2">
    <div>
      <h2 class="text-3xl sm:text-4xl">{t('area.title')}</h2>
      <p class="mt-4 text-lg text-[var(--color-text-secondary)]">{t('area.text')}</p>
      <a
        href={site.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-1.5 font-semibold text-[var(--color-accent)]"
      >
        {t('footer.mapsReview')}
        <Icon name="arrow-up-right" />
      </a>
    </div>
    <Image src={karte} alt={t('area.mapAlt')} width={880} height={919} class="w-full rounded-[var(--radius-2xl)] shadow-[var(--shadow-lg)]" loading="lazy" />
  </div>
</Section>

<Section id="kontakt" tone="accent">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl sm:text-4xl">{t('contact.title')}</h2>
    <p class="mt-4 text-lg text-[var(--color-text-secondary)]">{t('contact.text')}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <SocialIcon variant="button" platform="whatsapp" href={site.whatsappUrl} label={t('contact.whatsapp')} />
      <SocialIcon variant="button" platform="instagram" href={site.instagramUrl} label={t('contact.instagram')} />
      <SocialIcon variant="button" platform="maps" href={site.mapsUrl} label={t('contact.maps')} />
    </div>
    <p class="mt-6 text-sm text-[var(--color-text-secondary)]">{t('contact.consentHint')}</p>
  </div>
</Section>
